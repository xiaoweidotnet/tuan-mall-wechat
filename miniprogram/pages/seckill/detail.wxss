.page {
  padding: 20rpx;
  padding-bottom: 150rpx;
}

.hero {
  position: relative;
  margin-bottom: 20rpx;
}

.hero-img {
  width: 100%;
  height: 440rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  display: block;
}

.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 30rpx;
}

.hero-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  background: linear-gradient(90deg, #ff2d2d, #ff7a00);
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.price-row {
  flex-wrap: wrap;
}

.price .price-num {
  font-size: 44rpx;
}

.limit-tag {
  margin-left: auto;
  font-size: 22rpx;
  color: #ff5000;
  background: #fff2ec;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin: 8rpx 12rpx 0 0;
}

.status-card {
  background: linear-gradient(135deg, #fff8f2, #fff);
}

.status-row {
  margin-bottom: 10rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
}

.status-text.hot {
  color: #ff5000;
}

.countdown {
  display: flex;
  align-items: baseline;
}

.countdown-label {
  font-size: 22rpx;
  color: #999;
  margin-right: 8rpx;
}

.countdown-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff5000;
  font-variant-numeric: tabular-nums;
}

.status-tip {
  font-size: 24rpx;
  color: #999;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.panel-row {
  margin-bottom: 20rpx;
}

.panel-inline-label {
  color: #666;
  font-size: 26rpx;
}

.panel-label {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f2f2f2;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
}

.stepper-input {
  width: 90rpx;
  text-align: center;
  font-size: 30rpx;
}

.method-list {
  display: flex;
}

.method-item {
  border: 1rpx solid #ddd;
  color: #666;
  border-radius: 32rpx;
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.method-item.active {
  border-color: #ff5000;
  color: #ff5000;
  background: #fff5f0;
}

.addr-input {
  height: 120rpx;
}

.picker-value {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.rule-card {
  margin-bottom: 0;
}

.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

.rule-tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-price {
  display: flex;
  flex-direction: column;
}

.submit-price .price-num {
  font-size: 40rpx;
}

.submit-btn {
  background: linear-gradient(90deg, #ff5000, #ff8a00);
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 70rpx;
  font-size: 30rpx;
}

.submit-btn.disabled {
  background: #ccc;
}
