.group-card {
  padding: 20rpx;
}

.card-main {
  display: flex;
}

.cover-wrap {
  flex-shrink: 0;
  width: 220rpx;
  height: 220rpx;
  margin-right: 20rpx;
}

.cover {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 24rpx;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.title-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.bottom-row {
  margin-top: auto;
  margin-bottom: 12rpx;
}

.footer-row {
  border-top: 1rpx solid #f2f2f2;
  padding-top: 14rpx;
}

.countdown {
  color: #ff5000;
  font-size: 24rpx;
}

.stock {
  margin-left: 16rpx;
}

.buy-btn {
  background: linear-gradient(90deg, #ff5000, #ff8a00);
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 10rpx 36rpx;
  flex-shrink: 0;
}

/* ===== 限时秒杀（首页横滑卡片） ===== */
.seckill-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.seckill-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.seckill-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff3000;
  margin-right: 16rpx;
}

.seckill-sub {
  font-size: 22rpx;
  color: #ff8a00;
}

.seckill-scroll {
  white-space: nowrap;
}

.seckill-card {
  display: inline-block;
  width: 250rpx;
  margin-right: 20rpx;
  vertical-align: top;
  background: #fff8f2;
  border: 1rpx solid #ffe3d1;
  border-radius: 12rpx;
  overflow: hidden;
}

.seckill-cover-wrap {
  position: relative;
}

.seckill-cover {
  width: 250rpx;
  height: 200rpx;
  display: block;
  background: #f0f0f0;
}

.seckill-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 26rpx;
}

.seckill-corner {
  position: absolute;
  left: 0;
  top: 0;
  background: rgba(255, 45, 0, 0.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-bottom-right-radius: 10rpx;
}

.seckill-body {
  padding: 14rpx 16rpx 18rpx;
}

.seckill-name {
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.seckill-price-row {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0;
}

.seckill-price {
  color: #ff3000;
  font-size: 32rpx;
  font-weight: 700;
}

.seckill-original {
  color: #999;
  font-size: 20rpx;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.seckill-meta {
  font-size: 20rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.seckill-btn {
  margin-top: 12rpx;
  text-align: center;
  background: linear-gradient(90deg, #ff3000, #ff8a00);
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 8rpx 0;
}

.seckill-btn.soon {
  background: #ffd9cc;
  color: #ff5000;
}
