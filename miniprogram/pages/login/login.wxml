<view class="login-page">
  <view class="logo-area">
    <view class="logo">团</view>
    <view class="app-name">团购商城</view>
    <view class="slogan">邻里团购 · 好物拼着买</view>
  </view>

  <!-- 登录方式切换：微信授权 / 手机号验证码 -->
  <view class="login-tabs">
    <view
      class="login-tab {{loginMode === 'wechat' ? 'active' : ''}}"
      data-mode="wechat"
      bindtap="onSwitchMode"
    >微信登录</view>
    <view
      class="login-tab {{loginMode === 'phone' ? 'active' : ''}}"
      data-mode="phone"
      bindtap="onSwitchMode"
    >手机号登录</view>
  </view>

  <!-- 微信授权登录（主入口）：授权后需完善头像/昵称 -->
  <block wx:if="{{loginMode === 'wechat'}}">
    <view class="btn-wechat login-btn {{loading ? 'disabled' : ''}}" bindtap="onWechatLogin">
      {{loading ? '登录中...' : '微信授权登录'}}
    </view>
    <view class="login-tip">新用户授权后请完善头像和昵称</view>
  </block>

  <!-- 手机号 + 短信验证码登录：未注册手机号验证通过后自动建档 -->
  <block wx:else>
    <view class="login-card">
      <view class="form-label">手机号</view>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />

      <view class="form-label code-label">验证码</view>
      <view class="code-row">
        <input
          class="form-input code-input"
          type="number"
          maxlength="6"
          placeholder="请输入 6 位验证码"
          value="{{code}}"
          bindinput="onCodeInput"
          confirm-type="done"
          bindconfirm="onPhoneLogin"
        />
        <view
          class="btn-code {{countdown > 0 || sending ? 'disabled' : ''}}"
          bindtap="onSendCode"
        >{{countdown > 0 ? countdown + 's 后重发' : (sending ? '发送中...' : '获取验证码')}}</view>
      </view>

      <view class="btn-primary login-btn {{loading ? 'disabled' : ''}}" bindtap="onPhoneLogin">
        {{loading ? '登录中...' : '登录'}}
      </view>
      <view class="login-tip">未注册手机号验证通过后自动创建账号</view>
    </view>
  </block>

  <!-- 开发用模拟登录（保留：本地无微信密钥时快速体验） -->
  <view class="mock-divider"><text class="mock-divider-text">开发模拟登录</text></view>
  <view class="login-card">
    <view class="form-label">昵称</view>
    <input
      class="form-input"
      placeholder="输入昵称即可登录（模拟微信授权）"
      value="{{nickname}}"
      bindinput="onInput"
      confirm-type="done"
      bindconfirm="onLogin"
    />
    <view class="btn-primary login-btn {{loading ? 'disabled' : ''}}" bindtap="onLogin">
      {{loading ? '登录中...' : '一键登录'}}
    </view>
  </view>
</view>
