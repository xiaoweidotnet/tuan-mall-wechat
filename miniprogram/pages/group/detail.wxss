.page {
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.banner {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #f0f0f0;
}

.main-image {
  width: 100%;
  height: 400rpx;
}

.detail-image {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  background: #f0f0f0;
}

.title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.product-title {
  margin-bottom: 10rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.meta-item {
  display: inline-block;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin: 8rpx 12rpx 0 0;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.sold {
  margin-left: auto;
}

.desc {
  margin-top: 16rpx;
  line-height: 1.6;
}

.notice-card {
  padding: 20rpx 24rpx;
}

.notice {
  color: #ff5000;
  font-size: 26rpx;
}

.notice.ended {
  color: #999;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.panel-row {
  margin-bottom: 20rpx;
}

.panel-label {
  color: #666;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #f2f2f2;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #333;
}

.stepper-input {
  width: 90rpx;
  text-align: center;
  font-size: 30rpx;
}

.method-list {
  display: flex;
}

.method-item {
  border: 1rpx solid #ddd;
  color: #666;
  border-radius: 32rpx;
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.method-item.active {
  border-color: #ff5000;
  color: #ff5000;
  background: #fff5f0;
}

.addr-input {
  height: 120rpx;
}

.picker-value {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.amount-box {
  border-top: 1rpx solid #f2f2f2;
  padding-top: 16rpx;
}

.amount-row {
  margin-bottom: 8rpx;
}

.amount-tip {
  text-align: right;
  color: #ff8a00;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  background: linear-gradient(90deg, #ff5000, #ff8a00);
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 70rpx;
  font-size: 30rpx;
}

.submit-btn.disabled {
  background: #ccc;
}
