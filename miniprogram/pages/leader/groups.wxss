.title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.group-head {
  align-items: flex-start;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  background: #f0f0f0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 20rpx;
}

.title-col {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.status {
  font-size: 24rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-active {
  color: #ff5000;
}

.status-succeeded {
  color: #07c160;
}

.status-failed,
.status-cancelled {
  color: #999;
}

.info-row {
  margin-bottom: 8rpx;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f2f2f2;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.publish-btn {
  margin: 20rpx 0 60rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-item {
  margin-bottom: 20rpx;
}

.picker-box {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 18rpx 30rpx;
  margin-right: 20rpx;
  color: #333;
  min-width: 180rpx;
  text-align: center;
}

.method-item {
  border: 1rpx solid #ddd;
  color: #666;
  border-radius: 32rpx;
  padding: 10rpx 32rpx;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.method-item.active {
  border-color: #ff5000;
  color: #ff5000;
  background: #fff5f0;
}

.rule-input {
  flex: 1;
}

.rule-sep {
  margin: 0 20rpx;
  color: #666;
}

.modal-submit {
  margin-top: 32rpx;
}

.modal-cancel {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 20rpx 0 8rpx;
}
