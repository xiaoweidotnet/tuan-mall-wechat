.status {
  color: #ff5000;
  font-size: 26rpx;
}

.order-body {
  margin: 20rpx 0;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.addr {
  margin-top: 6rpx;
  max-width: 460rpx;
}

.ship-box {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ship-input {
  flex: 1;
  margin-right: 20rpx;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f2f2f2;
  padding-top: 16rpx;
}
